# ============================================================
# DEPRECATED — use the monorepo root `.env` only
# ============================================================
#
# All mobile vars (EXPO_PUBLIC_*) live in:
#   ../../.env          (from artifacts/habit-mobile)
#   /workspace/.env     (repo root)
#
# Template: ../../.env.example
#
# setup.sh / scripts create a symlink:
#   artifacts/habit-mobile/.env → ../../.env
#
# Do not maintain a separate mobile .env. Copy once at the root:
#   cp .env.example .env
#
# If Expo does not pick up vars, from this folder run:
#   ln -sfn ../../.env .env
#
