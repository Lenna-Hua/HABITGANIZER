{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:web": "pnpm --filter @workspace/habit-tracker run build",
    "portfolio:record": "playwright test e2e/portfolio-walkthrough.spec.ts --project=chromium",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
